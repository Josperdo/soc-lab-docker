*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
click-params.json
pip-wheel-metadata/
share/python-wheels/

# Python testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Python packaging
*.egg-info/
*.egg
MANIFEST

# Poetry (if used)
poetry.lock
dist/

