# ============================================================================

# Generated API documentation
generated/
/docs/_build/
site/

# Test outputs
test-results/
test-reports/
*.xml
*.junit

# Temporary files
*.tmp
*.temp
tmp/

# ============================================================================
# IDE Editor Config
# ============================================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / PyCharm
.idea/*
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

