# SOC Lab Docker – Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# ELASTIC STACK VERSION
# ============================================================================

# Version of Elasticsearch, Kibana, and Filebeat to deploy.
# All three must use the same version number.
ELASTIC_VERSION=8.11.1

# ============================================================================
# DOCKER COMPOSE SETTINGS
# ============================================================================

# Project name (used for container naming and volume prefixes)
COMPOSE_PROJECT_NAME=soc-lab

# Docker Compose file to use
COMPOSE_FILE=docker-compose.yml

# Environment mode: development, staging, production
ENVIRONMENT=development

# ============================================================================
# DATA STORE CONFIGURATION (Elasticsearch / Data Lake)
# ============================================================================

# Elasticsearch host and port
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Elasticsearch cluster name
ELASTICSEARCH_CLUSTER_NAME=soc-lab-cluster

# Elasticsearch initial heap memory
# 1g is the recommended minimum – 512m will hit circuit breaker errors under ES|QL queries
ELASTICSEARCH_HEAP_SIZE=1g

# Elasticsearch data directory (host-mounted volume)
ELASTICSEARCH_DATA_DIR=./data/elasticsearch

# Database name or index prefix
INDEX_PREFIX=soc-lab

# Data retention policy (days)
DATA_RETENTION_DAYS=7

# ============================================================================
# LOG GENERATOR CONFIGURATION
# ============================================================================

# Log generator enabled (true/false)
LOG_GENERATOR_ENABLED=true

# Log generation rate (events per second)
LOG_GENERATION_RATE=10

# Log generator output directory
LOG_GENERATOR_OUTPUT_DIR=./data/logs

# Event types to generate (comma-separated)
# Options: authentication, web_traffic, process_execution, network, security_alerts
EVENT_TYPES=authentication,web_traffic,process_execution,network

# Synthetic user count (for event generation)
SYNTHETIC_USER_COUNT=50

# Synthetic host count
SYNTHETIC_HOST_COUNT=20

# ============================================================================
# LOG AGGREGATOR / FORWARDER CONFIGURATION
# ============================================================================

# Aggregator service (filebeat, logstash, fluentd, etc.)
AGGREGATOR_SERVICE=filebeat

# Aggregator port (for log input)
AGGREGATOR_PORT=5000

# Log input files to monitor (comma-separated paths)
LOG_INPUT_FILES=./data/logs/*.json

# ============================================================================
# WEB UI CONFIGURATION
# ============================================================================

# Web UI port (Kibana, Grafana, or custom dashboard)
WEB_UI_PORT=5601

# Web UI host binding
WEB_UI_HOST=0.0.0.0

# Query tool endpoint (for direct API access)
QUERY_TOOL_ENDPOINT=http://localhost:9200

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# Default admin username (for web UI login)
ADMIN_USERNAME=admin

# Default admin password
# ⚠️  SECURITY WARNING: Change this immediately in production environments
# For development only – never commit real credentials to version control
ADMIN_PASSWORD=changeme123

# Enable SSL/TLS (true/false) – for development, typically false
ENABLE_TLS=false

# TLS certificate path (if enabled)
TLS_CERT_PATH=./certs/server.crt

# TLS key path (if enabled)
TLS_KEY_PATH=./certs/server.key

# Network isolation: true (isolated), false (host network)
# For development/learning, typically false; use true in production
NETWORK_ISOLATED=false

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Docker log driver (json-file, syslog, awslogs, etc.)
LOG_DRIVER=json-file

# Log level for lab services (debug, info, warning, error)
LOG_LEVEL=info

# Enable container resource limits (true/false)
RESOURCE_LIMITS_ENABLED=false

# Max CPU per container (e.g., 0.5, 1.0)
MAX_CPU=1.0

# Max memory per container (e.g., 512m, 1g)
MAX_MEMORY=1g

# ============================================================================
# ATTACK SIMULATION CONFIGURATION
# ============================================================================

# Attack simulation enabled (true/false)
ATTACK_SIMULATION_ENABLED=false

# Attack simulation schedule (cron format or 'manual')
# Examples: '0 */6 * * *' (every 6 hours), 'manual' (run via script)
ATTACK_SCHEDULE=manual

# Attack simulation scenario type (brute_force, lateral_movement, exfiltration, etc.)
ATTACK_SCENARIO=brute_force

# Target host for attack simulation
ATTACK_TARGET_HOST=web-server-01

# Number of attack simulation steps
ATTACK_STEP_COUNT=10

# Delay between attack steps (milliseconds)
ATTACK_STEP_DELAY_MS=500

# ============================================================================
# OPTIONAL: CLOUD INTEGRATION
# ============================================================================

# Cloud provider (none, aws, azure, gcp)
CLOUD_PROVIDER=none

# AWS region (if using AWS)
AWS_REGION=us-east-1

# AWS S3 bucket for log archival (if enabled)
AWS_S3_BUCKET=soc-lab-logs

# Azure subscription ID (if using Azure)
AZURE_SUBSCRIPTION_ID=

# Azure resource group
AZURE_RESOURCE_GROUP=soc-lab-rg

# ============================================================================
# DEBUG & DEVELOPMENT
# ============================================================================

# Debug mode (true/false)
DEBUG_MODE=false

# Verbose logging (true/false)
VERBOSE=false

# Keep containers running on error (true/false)
KEEP_RUNNING_ON_ERROR=false

# Docker-in-Docker (required for some advanced scenarios)
DOCKER_IN_DOCKER_ENABLED=false

# ============================================================================
# NOTES
# ============================================================================

# This file should be copied to .env and customized for your environment.
# Do NOT commit the .env file to version control if it contains sensitive data.
# Use .env.example as a template and document any additional variables
# required for your deployment.
#
# For multi-environment setups, create additional files:
#   .env.local       (local development)
#   .env.staging     (staging environment)
#   .env.production  (production environment)
#
# Load the appropriate .env file before running docker-compose:
#   export $(cat .env.production | xargs)
#   docker-compose up -d
